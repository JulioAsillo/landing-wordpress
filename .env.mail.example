# Copiar a .env.mail y completar. El archivo .env.mail NUNCA se sube al
# repositorio (está excluido en .gitignore).
#
# DESARROLLO: dejar los valores tal como están. Los correos quedan
# capturados por Mailpit y no salen a internet.
#
# PRODUCCIÓN: usar los datos del servidor de correo corporativo.
#   SMTP_HOST=correo.<dominio-del-cliente>
#   SMTP_PORT=465
#   SMTP_ENCRYPTION=ssl        # 'ssl' para el puerto 465, 'tls' para el 587
#   SMTP_USER=<cuenta de envío>
#   SMTP_PASSWORD=<contraseña de la cuenta de envío>
#   SMTP_FROM=<misma cuenta de envío>
# El remitente debe ser siempre la cuenta autenticada: si se usa otra,
# el servidor de correo rechaza el envío.

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_ENCRYPTION=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Garantiza
