# Copiar a .env y completar. El archivo .env NUNCA se sube al repositorio.
# Generar contraseñas con: openssl rand -base64 24

DB_NAME=landing_wp
DB_USER=wp_user
DB_PASSWORD=CAMBIAR_ESTO
DB_ROOT_PASSWORD=CAMBIAR_ESTO_TAMBIEN

# URL con la que se accede al sitio en desarrollo.
# Debe coincidir con cómo lo abres en el navegador, o WordPress
# redirige en bucle y las rutas de CSS/JS se rompen.
WP_URL=http://34.132.80.1

# 1 en desarrollo, 0 antes de entregar
WP_DEBUG=1
