# =============================================================================
#  Landing Garantiza — parámetros de despliegue
#  Copiar a garantiza.env y completar. Aquí NO va ninguna contraseña:
#  las contraseñas se cargan como secrets con ./crear-secrets.sh
#  Valores con espacios: entre comillas dobles.
# =============================================================================

# --- Imágenes ----------------------------------------------------------------
# Versión a desplegar (la del paquete entregado).
GZ_VERSION=1.0.0
# Prefijo del registry, CON barra final. Ejemplo:
#   GZ_IMAGE_PREFIX=registry.gitlab.empresa.pe/infra/garantiza/
# Dejar vacío solo si las imágenes se cargaron con "docker load" en un
# Swarm de un único nodo.
GZ_IMAGE_PREFIX=

# --- Sitio -------------------------------------------------------------------
GZ_DOMINIO=garantiza.pe
GZ_URL=https://garantiza.pe
# 1 = visible para buscadores (producción). 0 = pedir que no se indexe
# (entornos de prueba).
GZ_INDEXAR=1
# Años que se conservan los registros de los formularios antes de
# eliminarse automáticamente.
GZ_RETENCION_ANIOS=5

# --- Administrador inicial de WordPress --------------------------------------
# Evitar nombres predecibles (admin, administrador, garantiza).
# La contraseña la genera el aprovisionamiento y se muestra una sola vez.
GZ_ADMIN_USER=
GZ_ADMIN_EMAIL=

# --- Traefik (datos de la plataforma) ----------------------------------------
# Red overlay a la que está conectado Traefik:  docker network ls
TRAEFIK_NETWORK=traefik-public
# Entrypoint HTTPS y resolver de certificados, tal como se llaman en la
# configuración de Traefik.
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Correo saliente ---------------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
# ssl para el puerto 465, tls para el 587
SMTP_ENCRYPTION=ssl
SMTP_USER=
# Debe ser la misma cuenta que SMTP_USER, o el servidor rechazará el envío.
SMTP_FROM=
SMTP_FROM_NAME="Garantiza"
# Nombre del secret con la clave SMTP. Solo se cambia al rotar la clave.
GZ_SECRET_SMTP=gz_smtp_password
